{
  "manifest_version": 3,
  "name": "ContestRadar",
  "version": "0.1.0",
  "description": "The next five coding contests from Codeforces, LeetCode, CodeChef, AtCoder, and HackerRank.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ContestRadar",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://contestradar.vercel.app/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
